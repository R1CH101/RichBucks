# Copy to .env / Coolify — never commit real values
# Production compose sets NODE_ENV=production and refuses placeholder secrets.

# --- Chain / RPC ---
CHAIN_ID=88420
RPC_URL=http://validator-1:8545
PUBLIC_RPC_URL=https://rpc.richbucks.xyz
BESU_VERSION=25.1.0
# Required in production (rpc-filter). Pass as x-api-key / Bearer / ?key=
RPC_API_KEY=
RPC_REQUIRE_API_KEY=true
RPC_RATE_MAX=120

# Deployer / contract owner (admin ONLY — compose blanks this in the bot container)
DEPLOYER_PRIVATE_KEY=
# Public address of deployer — used by chain-init to prefund genesis (or set TREASURY_ADDRESS)
DEPLOYER_ADDRESS=
CONTRACT_ADDRESS=
TREASURY_ADDRESS=

# Separate bot welcome-minter key. After deploy: setWelcomeMinter(minterAddress)
WELCOME_MINTER_PRIVATE_KEY=

# --- Custodial wallets (>= 32 chars; prefer: openssl rand -hex 32) ---
WALLET_ENCRYPTION_KEY=
WALLET_DB_PATH=/data/wallets.sqlite
WELCOME_PACK_RB=10

# --- Teams bot (single-tenant per app; multiple apps via admin UI) ---
# Bootstrap one app from env (imported into app-config on first boot). Add more under Admin → Teams apps.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Optional; defaults to WALLET_ENCRYPTION_KEY. Must match on bot + admin.
TEAMS_CONFIG_KEY=
TEAMS_CONFIG_DIR=/config
BOT_PORT=3978

# --- Admin UI ---
ADMIN_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
# Required in production: your office / home public IPs or CIDRs (comma-separated)
ADMIN_ALLOWED_IPS=
# Set true when admin is behind Cloudflare orange-cloud (uses CF-Connecting-IP)
ADMIN_TRUST_CLOUDFLARE=true
SHOW_METAMASK_CARD=false
COOKIE_SECURE=true

# --- Coworker join (v1.1 / VPN) — off by default ---
JOIN_ENABLED=false
NODE_JOIN_API_KEY=
BOOTNODE_ENODE=

GHCR_OWNER=r1ch101
TAG=latest
