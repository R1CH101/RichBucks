# Copy to .env for local/Coolify — never commit real values

# --- Chain / RPC ---
CHAIN_ID=88420
RPC_URL=http://validator-1:8545
PUBLIC_RPC_URL=https://rpc.richbucks.xyz
BESU_VERSION=25.1.0
EMPTY_BLOCK_PERIOD_SECONDS=3600

# Deployer / contract owner (hex private key, no 0x prefix or with — app normalizes)
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=
TREASURY_ADDRESS=

# --- Custodial wallets ---
WALLET_ENCRYPTION_KEY=change-me-to-32-bytes-hex-or-long-passphrase
WALLET_DB_PATH=/data/wallets.sqlite
WELCOME_PACK_RB=10

# --- Teams bot ---
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
BOT_PORT=3978

# --- Admin UI ---
ADMIN_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOTP_SECRET=
SESSION_SECRET=change-me-long-random
SHOW_METAMASK_CARD=false

# --- Coworker join ---
NODE_JOIN_API_KEY=change-me-join-token
BOOTNODE_ENODE=

# --- Public RPC proxy ---
RPC_API_KEY=
